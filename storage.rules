rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isTeamOwner(teamId) {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/teams/$(teamId)).data.createdBy == request.auth.uid;
    }

    function validImage() {
      return request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    match /teams/{teamId}/profile {
      allow get: if request.auth != null && (isTeamOwner(teamId)
        || firestore.exists(/databases/(default)/documents/teamMemberships/$(teamId + '_' + request.auth.uid)));
      allow create, update: if isTeamOwner(teamId) && validImage();
      allow delete: if isTeamOwner(teamId);
    }

    match /playerProfiles/{playerId}/photo.jpg {
      allow get, delete: if request.auth != null && request.auth.uid == playerId;
      allow create, update: if request.auth != null && request.auth.uid == playerId && validImage();
    }
  }
}
