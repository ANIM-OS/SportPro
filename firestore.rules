rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // El rol ENTRENADOR lo elige el usuario; la aprobación solo se crea desde la consola.
    function isApprovedCoach() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['ENTRENADOR'])
        && exists(/databases/$(database)/documents/coachApprovals/$(request.auth.uid))
        && get(/databases/$(database)/documents/coachApprovals/$(request.auth.uid)).data.approved == true;
    }

    // US-09. New collections only; existing team and community rules stay intact.
    function ownsCallupTeam(teamId) {
      return request.auth != null
        && get(/databases/$(database)/documents/teams/$(teamId)).data.createdBy == request.auth.uid;
    }
    function callupOwnsTeam(teamId) {
      return isApprovedCoach() && ownsCallupTeam(teamId);
    }
    function callupMember(teamId, playerId, category) {
      let member = get(/databases/$(database)/documents/teamMemberships/$(teamId + '_' + playerId)).data;
      return member.teamId == teamId && member.userId == playerId && member.category == category;
    }
    match /matchFixtures/{matchId} {
      allow read: if request.auth != null && (
        ownsCallupTeam(resource.data.teamId)
        || callupMember(resource.data.teamId, request.auth.uid, resource.data.category)
      );
      function validFixture() {
        let d = request.resource.data;
        return d.keys().hasAll(['teamId', 'ownerId', 'category', 'opponent', 'kickoff', 'updatedAt'])
          && d.keys().hasOnly(['teamId', 'ownerId', 'category', 'opponent', 'kickoff', 'responseDeadline', 'updatedAt'])
          && d.teamId is string && d.ownerId == request.auth.uid
          && callupOwnsTeam(d.teamId)
          && get(/databases/$(database)/documents/teams/$(d.teamId)).data.type == 'EQUIPO'
          && d.category is string
          && d.category in get(/databases/$(database)/documents/teams/$(d.teamId)).data.categories
          && d.opponent is string && d.opponent.size() > 0 && d.opponent.size() <= 100
          && d.kickoff is timestamp && d.kickoff > request.time
          && d.get('responseDeadline', d.kickoff) is timestamp
          && d.get('responseDeadline', d.kickoff) > request.time
          && d.get('responseDeadline', d.kickoff) <= d.kickoff
          && d.updatedAt == request.time;
      }
      allow create: if request.auth != null && validFixture();
      allow update: if request.auth != null && validFixture()
        && resource.data.get('responseDeadline', resource.data.kickoff) > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['opponent', 'kickoff', 'responseDeadline', 'updatedAt']);
      allow delete: if ownsCallupTeam(resource.data.teamId);
    }
    match /matchCallupPlayers/{selectionId} {
      allow read: if request.auth != null && (
        resource.data.playerId == request.auth.uid || resource.data.ownerId == request.auth.uid
        || availabilityGuardian(resource.data.playerId)
      );
      function validSelection() {
        let d = request.resource.data;
        let fixture = getAfter(/databases/$(database)/documents/matchFixtures/$(d.matchId)).data;
        return d.keys().hasAll(['matchId', 'teamId', 'ownerId', 'playerId', 'selected', 'updatedAt'])
          && d.keys().hasOnly(['matchId', 'teamId', 'ownerId', 'playerId', 'selected', 'encounter', 'updatedAt'])
          && d.matchId is string && d.playerId is string && d.teamId is string
          && selectionId == d.matchId + '_' + d.playerId
          && d.ownerId == request.auth.uid && callupOwnsTeam(d.teamId)
          && fixture.teamId == d.teamId && fixture.ownerId == d.ownerId
          && fixture.kickoff > request.time
          && d.selected is bool
          && (d.selected || !existsAfter(/databases/$(database)/documents/matchLineups/$(d.matchId)/players/$(d.playerId)))
          && (!d.selected || (resource != null && resource.data.selected == true
              && get(/databases/$(database)/documents/matchFixtures/$(d.matchId)).data != fixture
              && d.diff(resource.data).affectedKeys().hasOnly(['encounter', 'updatedAt']))
            || callupMember(d.teamId, d.playerId, fixture.category))
          && (!d.keys().hasAny(['encounter']) || (
            d.encounter.keys().hasAll(['opponent', 'category', 'kickoff', 'responseDeadline'])
            && d.encounter.keys().hasOnly(['opponent', 'category', 'kickoff', 'responseDeadline'])
            && d.encounter.opponent == fixture.opponent && d.encounter.category == fixture.category
            && d.encounter.kickoff == fixture.kickoff
            && d.encounter.responseDeadline == fixture.get('responseDeadline', fixture.kickoff)))
          && d.updatedAt == request.time;
      }
      allow create: if request.auth != null && validSelection();
      allow update: if request.auth != null && validSelection()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['selected', 'encounter', 'updatedAt']);
      allow delete: if ownsCallupTeam(resource.data.teamId);
    }


    // US-11: match-specific lineups. General teamLineups are unchanged.
    function lineupFixture(matchId) {
      return get(/databases/$(database)/documents/matchFixtures/$(matchId)).data;
    }
    function canReadMatchLineup(matchId) {
      let fixture = lineupFixture(matchId);
      return request.auth != null && (ownsCallupTeam(fixture.teamId)
        || callupMember(fixture.teamId, request.auth.uid, fixture.category));
    }
    function canWriteMatchLineup(matchId) {
      let fixture = lineupFixture(matchId);
      return request.auth != null && callupOwnsTeam(fixture.teamId) && request.time < fixture.kickoff;
    }
    function starterPosition(position) {
      return position in ['P0','P1','P2','P3','P4','P5','P6','P7','P8','P9','P10'];
    }
    match /matchLineups/{matchId} {
      allow read: if canReadMatchLineup(matchId);
      allow create, update: if canWriteMatchLineup(matchId)
        && request.resource.data.keys().hasAll(['teamId','formation','updatedAt'])
        && request.resource.data.keys().hasOnly(['teamId','formation','updatedAt'])
        && request.resource.data.teamId == lineupFixture(matchId).teamId
        && request.resource.data.formation in ['4-3-3','4-4-2','3-5-2']
        && request.resource.data.updatedAt == request.time;
      allow delete: if ownsCallupTeam(lineupFixture(matchId).teamId);
      match /players/{playerId} {
        allow read: if canReadMatchLineup(matchId);
        function validAssignment() {
          let d = request.resource.data;
          let fixture = lineupFixture(matchId);
          let callup = get(/databases/$(database)/documents/matchCallupPlayers/$(matchId + '_' + playerId)).data;
          return d.keys().hasAll(['playerId','kind','position','updatedAt'])
            && d.keys().hasOnly(['playerId','kind','position','updatedAt'])
            && d.playerId == playerId
            && callup.selected == true && callup.matchId == matchId && callup.teamId == fixture.teamId
            && callupMember(fixture.teamId, playerId, fixture.category)
            && getAfter(/databases/$(database)/documents/matchLineups/$(matchId)).data.formation in ['4-3-3','4-4-2','3-5-2']
            && ((d.kind == 'STARTER' && starterPosition(d.position)
                && getAfter(/databases/$(database)/documents/matchLineups/$(matchId)/slots/$(d.position)).data.playerId == playerId)
              || (d.kind == 'BENCH' && d.position in ['POR','DEF','MED','DEL']))
            && (resource == null || resource.data.kind != 'STARTER'
              || (d.kind == 'STARTER' && d.position == resource.data.position)
              || !existsAfter(/databases/$(database)/documents/matchLineups/$(matchId)/slots/$(resource.data.position)))
            && d.updatedAt == request.time;
        }
        allow create, update: if canWriteMatchLineup(matchId) && validAssignment();
        allow delete: if ownsCallupTeam(lineupFixture(matchId).teamId) && (resource.data.kind != 'STARTER'
          || !existsAfter(/databases/$(database)/documents/matchLineups/$(matchId)/slots/$(resource.data.position)));
      }
      match /slots/{position} {
        allow read: if canReadMatchLineup(matchId);
        function validSlot() {
          let d = request.resource.data;
          let assignment = getAfter(/databases/$(database)/documents/matchLineups/$(matchId)/players/$(d.playerId)).data;
          return starterPosition(position) && d.keys().hasAll(['playerId','updatedAt'])
            && d.keys().hasOnly(['playerId','updatedAt']) && d.playerId is string
            && assignment.playerId == d.playerId && assignment.kind == 'STARTER' && assignment.position == position
            && (resource == null || resource.data.playerId == d.playerId
              || !existsAfter(/databases/$(database)/documents/matchLineups/$(matchId)/players/$(resource.data.playerId))
              || getAfter(/databases/$(database)/documents/matchLineups/$(matchId)/players/$(resource.data.playerId)).data.kind != 'STARTER'
              || getAfter(/databases/$(database)/documents/matchLineups/$(matchId)/players/$(resource.data.playerId)).data.position != position)
            && d.updatedAt == request.time;
        }
        allow create, update: if canWriteMatchLineup(matchId) && validSlot();
        allow delete: if ownsCallupTeam(lineupFixture(matchId).teamId) && (
          !existsAfter(/databases/$(database)/documents/matchLineups/$(matchId)/players/$(resource.data.playerId))
          || getAfter(/databases/$(database)/documents/matchLineups/$(matchId)/players/$(resource.data.playerId)).data.kind != 'STARTER'
          || getAfter(/databases/$(database)/documents/matchLineups/$(matchId)/players/$(resource.data.playerId)).data.position != position);
      }
    }

    // US-10: one persistent response per selected player, shared with their authorized guardian.
    function availabilityGuardian(playerId) {
      return isVerifiedGuardianOf(playerId)
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['PADRE / TUTOR']);
    }
    function availabilityActor(playerId) {
      return request.auth != null && (
        (request.auth.uid == playerId
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['JUGADOR']))
        || availabilityGuardian(playerId));
    }
    match /matchAvailability/{selectionId} {
      allow get: if request.auth != null && (
        availabilityActor(get(/databases/$(database)/documents/matchCallupPlayers/$(selectionId)).data.playerId)
        || ownsCallupTeam(get(/databases/$(database)/documents/matchCallupPlayers/$(selectionId)).data.teamId));
      allow list: if request.auth != null && resource.data.ownerId == request.auth.uid
        && ownsCallupTeam(resource.data.teamId);
      function validResponse() {
        let d = request.resource.data;
        let selection = get(/databases/$(database)/documents/matchCallupPlayers/$(selectionId)).data;
        let fixture = get(/databases/$(database)/documents/matchFixtures/$(selection.matchId)).data;
        return d.keys().hasAll(['matchId', 'teamId', 'ownerId', 'playerId', 'status', 'respondedBy', 'updatedAt'])
          && d.keys().hasOnly(['matchId', 'teamId', 'ownerId', 'playerId', 'status', 'respondedBy', 'updatedAt'])
          && selection.selected == true
          && d.matchId == selection.matchId && d.teamId == selection.teamId
          && d.ownerId == selection.ownerId && d.playerId == selection.playerId
          && selectionId == d.matchId + '_' + d.playerId
          && fixture.teamId == d.teamId
          && callupMember(d.teamId, d.playerId, fixture.category)
          && availabilityActor(d.playerId)
          && request.time < fixture.get('responseDeadline', fixture.kickoff)
          && request.time < fixture.kickoff
          && d.status in ['AVAILABLE', 'UNAVAILABLE']
          && d.respondedBy == request.auth.uid && d.updatedAt == request.time;
      }
      allow create: if request.auth != null && validResponse();
      allow update: if request.auth != null && validResponse()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedBy', 'updatedAt']);
      allow delete: if ownsCallupTeam(resource.data.teamId);
    }

    // =========================
    // USUARIOS
    // =========================
    match /users/{userId} {

      allow read: if request.auth != null
        && request.auth.uid == userId;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'email',
          'roles',
          'profileComplete',
          'firstName',
          'lastName',
          'createdAt'
        ])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.profileComplete == true
        && request.resource.data.roles is list
        && request.resource.data.roles.size() > 0
        && request.resource.data.roles.hasOnly([
          'JUGADOR',
          'ENTRENADOR',
          'PADRE / TUTOR'
        ])
        && (!request.resource.data.keys().hasAny(['firstName'])
          || (request.resource.data.firstName is string
            && request.resource.data.firstName.size() > 0
            && request.resource.data.firstName.size() <= 100))
        && (!request.resource.data.keys().hasAny(['lastName'])
          || (request.resource.data.lastName is string
            && request.resource.data.lastName.size() > 0
            && request.resource.data.lastName.size() <= 100))
        && (resource == null
          ? (!request.resource.data.keys().hasAny(['createdAt'])
            || request.resource.data.createdAt == request.time)
          : request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null));

      allow delete: if false;
    }


    // =========================
    // US-18: COMUNIDAD
    // =========================
    match /communityPosts/{postId} {

      allow read: if request.auth != null && (
        resource.data.visibility == 'TODOS'
        || resource.data.authorId == request.auth.uid
        || (resource.data.visibility in ['EQUIPO', 'ACADEMIA']
          && resource.data.teamId is string
          && (get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.createdBy == request.auth.uid
            || exists(/databases/$(database)/documents/teamMemberships/$(resource.data.teamId + '_' + request.auth.uid))))
      );

      // Crear publicaciones
      allow create: if request.auth != null

        // El usuario debe tener perfil registrado
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )

        // Solo jugador o entrenador pueden publicar actualmente
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.roles.hasAny([
          'JUGADOR',
          'ENTRENADOR'
        ])

        // Solo permitimos estos campos
        && request.resource.data.keys().hasOnly([
          'authorId',
          'authorName',
          'authorRole',
          'content',
          'visibility',
          'createdAt',
          'active',
          'moderated',
          'teamId'
        ])

        // El autor debe ser el usuario autenticado
        && request.resource.data.authorId == request.auth.uid

        && request.resource.data.authorName is string

        // Evita que el usuario se atribuya otro rol
        && request.resource.data.authorRole in [
          'JUGADOR',
          'ENTRENADOR'
        ]

        && request.resource.data.authorRole in get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.roles

        // Publicar como entrenador exige aprobación
        && (request.resource.data.authorRole != 'ENTRENADOR' || isApprovedCoach())

        // Validación del contenido
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 1000

        // Opciones válidas de visibilidad
        && request.resource.data.visibility in [
          'TODOS',
          'EQUIPO',
          'ACADEMIA'
        ]

        // Fecha generada por Firebase
        && request.resource.data.createdAt == request.time

        // Una publicación nueva siempre comienza activa
        && request.resource.data.active == true
        && request.resource.data.moderated == false;

      // Un moderador designado o un administrador puede ocultar una publicación sin alterar su contenido.
      allow update: if request.auth != null
        && (exists(/databases/$(database)/documents/moderators/$(request.auth.uid)) || isAdmin())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['moderated'])
        && resource.data.moderated == false
        && request.resource.data.moderated == true;
      allow delete: if false;

      // US-19: permitir interacciones SOLO con publicaciones visibles y activas.
      function canInteractWithPost() {
        let path = /databases/$(database)/documents/communityPosts/$(postId);
        let post = get(path).data;
        return request.auth != null && exists(path)
          && post.active == true && post.moderated == false
          && (
            post.visibility == 'TODOS'
            || post.authorId == request.auth.uid
            || (post.visibility in ['EQUIPO', 'ACADEMIA']
              && post.get('teamId', '') is string
              && exists(/databases/$(database)/documents/teams/$(post.teamId))
              && (
                get(/databases/$(database)/documents/teams/$(post.teamId)).data.createdBy == request.auth.uid
                || exists(/databases/$(database)/documents/teamMemberships/$(post.teamId + '_' + request.auth.uid))
              ))
          );
      }

      function canModerateCommunity() {
        return request.auth != null && (
          isAdmin()
          || exists(/databases/$(database)/documents/moderators/$(request.auth.uid))
        );
      }

      match /comments/{commentId} {
        // Las consultas deben filtrar moderated == false.
        allow get: if canInteractWithPost()
          && (resource.data.moderated == false || canModerateCommunity());
        allow list: if canInteractWithPost() && resource.data.moderated == false;

        allow create: if canInteractWithPost()
          && request.resource.data.keys().hasAll([
            'authorId', 'authorName', 'text', 'createdAt', 'moderated'
          ])
          && request.resource.data.keys().hasOnly([
            'authorId', 'authorName', 'text', 'createdAt', 'moderated'
          ])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() > 0
          && request.resource.data.authorName.size() <= 150
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 300
          && request.resource.data.moderated == false
          && request.resource.data.createdAt == request.time;

        allow update: if canModerateCommunity()
          && resource.data.moderated == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['moderated'])
          && request.resource.data.moderated == true;
        allow delete: if false;

        match /reports/{reporterId} {
          // Los reportes NO se muestran públicamente.
          allow read: if canModerateCommunity();
          allow create: if canInteractWithPost()
            && reporterId == request.auth.uid
            && exists(/databases/$(database)/documents/communityPosts/$(postId)/comments/$(commentId))
            && get(/databases/$(database)/documents/communityPosts/$(postId)/comments/$(commentId)).data.moderated == false
            && get(/databases/$(database)/documents/communityPosts/$(postId)/comments/$(commentId)).data.authorId != request.auth.uid
            && request.resource.data.keys().hasAll(['reporterId', 'reason', 'createdAt'])
            && request.resource.data.keys().hasOnly(['reporterId', 'reason', 'createdAt'])
            && request.resource.data.reporterId == request.auth.uid
            && request.resource.data.reason is string
            && request.resource.data.reason.size() > 0
            && request.resource.data.reason.size() <= 500
            && request.resource.data.createdAt == request.time;
          allow update, delete: if false;
        }
      }

      match /likes/{userId} {
        allow read: if canInteractWithPost();
        allow create: if canInteractWithPost()
          && userId == request.auth.uid
          && request.resource.data.keys().hasAll(['userId', 'createdAt'])
          && request.resource.data.keys().hasOnly(['userId', 'createdAt'])
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if canInteractWithPost() && userId == request.auth.uid;
      }
    }

    match /moderators/{moderatorId} {
      allow get: if request.auth != null && request.auth.uid == moderatorId;
      allow list, write: if false;
    }

    // =========================
    // ADMINISTRADORES Y APROBACIÓN DE ENTRENADORES (se gestionan desde la consola)
    // =========================
    match /admins/{adminId} {
      allow get: if request.auth != null && request.auth.uid == adminId;
      allow list, write: if false;
    }

    match /coachApprovals/{coachId} {
      allow get: if request.auth != null && request.auth.uid == coachId;
      allow list, write: if false;
    }

    // =========================
    // US-20: AVISOS DE PRUEBAS Y CONVOCATORIAS
    // Vigente o vencido se calcula en la app con deadline (plan Spark, sin Cloud Functions).
    // =========================
    match /tryoutNotices/{noticeId} {
      allow read: if request.auth != null;

      allow create: if isApprovedCoach()
        && request.resource.data.keys().hasAll([
          'authorId', 'authorName', 'title', 'description', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'authorId', 'authorName', 'title', 'description', 'category', 'position',
          'tryoutDate', 'location', 'deadline', 'status', 'createdAt'
        ])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorName.size() <= 100
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 2000
        // Mismas listas que SportCatalog en la app
        && (!request.resource.data.keys().hasAny(['category'])
          || request.resource.data.category in [
            'SUB-10', 'SUB-12', 'SUB-15', 'SUB-17', 'PRIMERA', 'FEMENIL-SUB-15', 'FEMENIL-SUB-17'
          ])
        && (!request.resource.data.keys().hasAny(['position'])
          || request.resource.data.position in [
            'Portero', 'Defensa central', 'Lateral', 'Mediocampista', 'Extremo', 'Delantero'
          ])
        && (!request.resource.data.keys().hasAny(['location'])
          || (request.resource.data.location is string
            && request.resource.data.location.size() > 0
            && request.resource.data.location.size() <= 120))
        && (!request.resource.data.keys().hasAny(['tryoutDate'])
          || request.resource.data.tryoutDate is timestamp)
        // No se puede publicar un aviso ya vencido
        && (!request.resource.data.keys().hasAny(['deadline'])
          || (request.resource.data.deadline is timestamp
            && request.resource.data.deadline > request.time))
        // La app exige fecha límite <= día de la prueba; el margen cubre zonas horarias
        && (!request.resource.data.keys().hasAll(['deadline', 'tryoutDate'])
          || request.resource.data.deadline <= request.resource.data.tryoutDate + duration.value(2, 'd'))
        && request.resource.data.status == 'ACTIVE'
        && request.resource.data.createdAt == request.time;

      // Solo se puede cancelar: lo hace el autor (aunque ya no esté aprobado) o un administrador.
      allow update: if request.auth != null
        && (resource.data.authorId == request.auth.uid || isAdmin())
        && resource.data.status == 'ACTIVE'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt'])
        && request.resource.data.status == 'CANCELLED'
        && request.resource.data.cancelledAt == request.time;

      allow delete: if false;
    }

    // =========================
    // EQUIPOS Y ACADEMIAS
    // =========================
    match /teams/{teamId} {
      // La lista solo puede consultar equipos creados por el usuario.
      allow list: if request.auth != null
        && resource.data.createdBy == request.auth.uid;

      // Un miembro aceptado puede abrir su equipo por ID.
      allow get: if request.auth != null && (
        resource.data.createdBy == request.auth.uid
        || exists(/databases/$(database)/documents/teamMemberships/$(teamId + '_' + request.auth.uid))
      );

      allow create: if isApprovedCoach()
        && request.resource.data.keys().hasOnly([
          'createdBy', 'name', 'type', 'categories', 'playerCount', 'createdAt',
          'city', 'description', 'primaryColor', 'secondaryColor', 'foundedYear',
          'photoBase64', 'photoUpdatedAt', 'academyId'
        ])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.type in ['EQUIPO', 'ACADEMIA']
        && request.resource.data.categories is list
        && request.resource.data.categories.size() > 0
        && (!request.resource.data.keys().hasAny(['playerCount'])
          || request.resource.data.playerCount == 0)
        && request.resource.data.createdAt == request.time
        && validTeamDetails()
        && validAcademyLink();

      // US-03: solo un EQUIPO se vincula, a una ACADEMIA del mismo dueño que contenga
      // todas sus categorías. Sin academyId (o al borrarlo para desvincular) no aplica.
      function validAcademyLink() {
        let d = request.resource.data;
        return !d.keys().hasAny(['academyId'])
          || (d.academyId is string
            && d.type == 'EQUIPO'
            && d.academyId != teamId
            && get(/databases/$(database)/documents/teams/$(d.academyId)).data.type == 'ACADEMIA'
            && get(/databases/$(database)/documents/teams/$(d.academyId)).data.createdBy == request.auth.uid
            && get(/databases/$(database)/documents/teams/$(d.academyId)).data.categories.hasAll(d.categories));
      }

      function validTeamDetails() {
        return (!request.resource.data.keys().hasAny(['city'])
            || (request.resource.data.city is string && request.resource.data.city.size() <= 80))
          && (!request.resource.data.keys().hasAny(['description'])
            || (request.resource.data.description is string && request.resource.data.description.size() <= 500))
          && (!request.resource.data.keys().hasAny(['primaryColor'])
            || (request.resource.data.primaryColor is string && request.resource.data.primaryColor.size() <= 30))
          && (!request.resource.data.keys().hasAny(['secondaryColor'])
            || (request.resource.data.secondaryColor is string && request.resource.data.secondaryColor.size() <= 30))
          && (!request.resource.data.keys().hasAny(['foundedYear'])
            || (request.resource.data.foundedYear is int
              && request.resource.data.foundedYear >= 1850
              && request.resource.data.foundedYear <= 2100))
          && (!request.resource.data.keys().hasAny(['photoBase64'])
            || (request.resource.data.photoBase64 is string
              && request.resource.data.photoBase64.size() <= 800000))
          && (!request.resource.data.keys().hasAny(['photoUpdatedAt'])
            || request.resource.data.photoUpdatedAt is timestamp);
      }

      allow update: if request.auth != null
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'type', 'categories', 'city', 'description',
          'primaryColor', 'secondaryColor', 'foundedYear',
          'photoBase64', 'photoUpdatedAt', 'academyId'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.type in ['EQUIPO', 'ACADEMIA']
        && request.resource.data.categories is list
        && request.resource.data.categories.size() > 0
        && validTeamDetails()
        && validAcademyLink()
        // US-03 criterio 3: las reglas no pueden revisar los equipos vinculados, así que una
        // ACADEMIA solo puede añadir categorías; quitar una dejaría equipos inconsistentes.
        && (resource.data.type != 'ACADEMIA'
          || request.resource.data.categories.hasAll(resource.data.categories))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['photoUpdatedAt'])
          || request.resource.data.photoUpdatedAt == request.time);
      allow delete: if request.auth != null
        && resource.data.createdBy == request.auth.uid;
    }

    match /teamInvites/{inviteId} {
      allow read: if request.auth != null && (
        (request.auth.token.email_verified == true
          && resource.data.invitedEmail == request.auth.token.email)
        || get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.createdBy == request.auth.uid
      );

      allow create: if isApprovedCoach()
        && request.resource.data.keys().hasOnly([
          'teamId', 'teamName', 'category', 'invitedEmail', 'invitedBy', 'status', 'createdAt'
        ])
        && request.resource.data.teamId is string
        && request.resource.data.teamName is string
        // US-03 criterio 2: la invitación fija una categoría válida del equipo.
        && request.resource.data.category is string
        && request.resource.data.category in get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.categories
        && request.resource.data.invitedEmail is string
        && request.resource.data.invitedEmail.size() > 3
        && request.resource.data.invitedEmail.size() <= 254
        && request.resource.data.invitedEmail != request.auth.token.email
        && request.resource.data.invitedBy == request.auth.uid
        && request.resource.data.status == 'PENDING'
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.createdBy == request.auth.uid
        && request.resource.data.teamName == get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.name;

      allow update: if request.auth != null
        && request.auth.token.email_verified == true
        && resource.data.invitedEmail == request.auth.token.email
        && resource.data.status == 'PENDING'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['ACCEPTED', 'DECLINED'];
      allow delete: if request.auth != null
        && get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.createdBy == request.auth.uid;
    }

    match /teamMemberships/{membershipId} {
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid
        || get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.createdBy == request.auth.uid
        || exists(/databases/$(database)/documents/teamMemberships/$(resource.data.teamId + '_' + request.auth.uid))
        // US-06: el tutor verificado ve en qué equipos y categoría está su jugador.
        || isVerifiedGuardianOf(resource.data.userId)
      );

      allow create: if request.auth != null
        && request.auth.token.email_verified == true
        && request.resource.data.keys().hasOnly([
          'teamId', 'userId', 'inviteId', 'joinCodeId', 'acceptedAt',
          'playerName', 'category', 'jerseyNumber'
        ])
        && request.resource.data.teamId is string
        && request.resource.data.userId == request.auth.uid
        && membershipId == request.resource.data.teamId + '_' + request.auth.uid
        && request.resource.data.acceptedAt == request.time
        && (!request.resource.data.keys().hasAny(['playerName'])
          || (request.resource.data.playerName is string
            && request.resource.data.playerName.size() > 0
            && request.resource.data.playerName.size() <= 80))
        && (!request.resource.data.keys().hasAny(['category'])
          || (request.resource.data.category is string
            && request.resource.data.category in get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.categories))
        && (!request.resource.data.keys().hasAny(['jerseyNumber'])
          || (request.resource.data.jerseyNumber is int
            && request.resource.data.jerseyNumber >= 0
            && request.resource.data.jerseyNumber <= 99))
        && (
          (request.resource.data.keys().hasAny(['inviteId'])
            && !request.resource.data.keys().hasAny(['joinCodeId'])
            && request.resource.data.inviteId is string
            && getAfter(/databases/$(database)/documents/teamInvites/$(request.resource.data.inviteId)).data.status == 'ACCEPTED'
            && getAfter(/databases/$(database)/documents/teamInvites/$(request.resource.data.inviteId)).data.teamId == request.resource.data.teamId
            && getAfter(/databases/$(database)/documents/teamInvites/$(request.resource.data.inviteId)).data.invitedEmail == request.auth.token.email
            // Si la invitación tiene categoría, la membresía debe llevar exactamente esa.
            // Las invitaciones antiguas sin categoría siguen entrando "sin categoría".
            && (!getAfter(/databases/$(database)/documents/teamInvites/$(request.resource.data.inviteId)).data.keys().hasAny(['category'])
              || request.resource.data.get('category', '') == getAfter(/databases/$(database)/documents/teamInvites/$(request.resource.data.inviteId)).data.category))

        );

      // La aprobación y la membresía se escriben juntas.
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['teamId','userId','requestId','playerName','category','acceptedAt'])
        && request.resource.data.keys().hasOnly(['teamId','userId','requestId','playerName','category','acceptedAt'])
        && request.resource.data.teamId is string && request.resource.data.userId is string
        && request.resource.data.requestId is string
        && membershipId == request.resource.data.teamId + '_' + request.resource.data.userId
        && get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.createdBy == request.auth.uid
        && get(/databases/$(database)/documents/teamJoinRequests/$(request.resource.data.requestId)).data.status == 'PENDING'
        && getAfter(/databases/$(database)/documents/teamJoinRequests/$(request.resource.data.requestId)).data.status == 'APPROVED'
        && getAfter(/databases/$(database)/documents/teamJoinRequests/$(request.resource.data.requestId)).data.teamId == request.resource.data.teamId
        && getAfter(/databases/$(database)/documents/teamJoinRequests/$(request.resource.data.requestId)).data.playerId == request.resource.data.userId
        && getAfter(/databases/$(database)/documents/teamJoinRequests/$(request.resource.data.requestId)).data.playerName == request.resource.data.playerName
        && getAfter(/databases/$(database)/documents/teamJoinRequests/$(request.resource.data.requestId)).data.category == request.resource.data.category
        && request.resource.data.category in get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.categories
        && request.resource.data.acceptedAt == request.time;

      allow update: if request.auth != null
        && get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.createdBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playerName', 'category', 'jerseyNumber'])
        && request.resource.data.playerName is string
        && request.resource.data.playerName.size() > 0
        && request.resource.data.playerName.size() <= 80
        && request.resource.data.category in get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.categories
        && (!request.resource.data.keys().hasAny(['jerseyNumber'])
          || (request.resource.data.jerseyNumber is int
            && request.resource.data.jerseyNumber >= 0
            && request.resource.data.jerseyNumber <= 99));
      allow delete: if request.auth != null
        && get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.createdBy == request.auth.uid;
    }

    match /teamJoinRequests/{requestId} {
      allow read: if request.auth != null && (
        resource.data.playerId == request.auth.uid
        || get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.createdBy == request.auth.uid);
      function validNewRequest() {
        return request.auth != null && request.auth.token.email_verified == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['JUGADOR'])
        && request.resource.data.keys().hasAll(['teamId','playerId','codeId','playerName','category','status','createdAt'])
        && request.resource.data.keys().hasOnly(['teamId','teamName','playerId','codeId','playerName','category','status','createdAt'])
        && request.resource.data.teamId is string && request.resource.data.codeId is string
        && request.resource.data.playerId == request.auth.uid
        && requestId == request.resource.data.teamId + '_' + request.auth.uid
        && request.resource.data.playerName is string && request.resource.data.playerName.size() > 0
        && request.resource.data.playerName.size() <= 80
        && request.resource.data.category is string
        && request.resource.data.category in get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.categories
        && (!request.resource.data.keys().hasAny(['teamName']) ||
          request.resource.data.teamName == get(/databases/$(database)/documents/teamJoinCodes/$(request.resource.data.codeId)).data.teamName)
        && get(/databases/$(database)/documents/teamJoinCodes/$(request.resource.data.codeId)).data.teamId == request.resource.data.teamId
        && get(/databases/$(database)/documents/teamJoinCodes/$(request.resource.data.codeId)).data.expiresAt > request.time
        && !get(/databases/$(database)/documents/teamJoinCodes/$(request.resource.data.codeId)).data.keys().hasAny(['usedBy'])
        && get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.type == 'EQUIPO'
        && !exists(/databases/$(database)/documents/teamMemberships/$(request.resource.data.teamId + '_' + request.auth.uid))
        && request.resource.data.status == 'PENDING' && request.resource.data.createdAt == request.time;
      }
      allow create: if validNewRequest();
      allow update: if resource.data.status in ['DECLINED', 'APPROVED']
        && resource.data.playerId == request.auth.uid && validNewRequest();
      allow update: if request.auth != null && resource.data.status == 'PENDING'
        && get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.createdBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','resolvedAt'])
        && request.resource.data.status in ['APPROVED','DECLINED']
        && request.resource.data.resolvedAt == request.time
        && (request.resource.data.status == 'DECLINED' ||
          (getAfter(/databases/$(database)/documents/teamMemberships/$(resource.data.teamId + '_' + resource.data.playerId)).data.requestId == requestId
           && getAfter(/databases/$(database)/documents/teamMemberships/$(resource.data.teamId + '_' + resource.data.playerId)).data.userId == resource.data.playerId));
      allow delete: if request.auth != null && (
        get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.createdBy == request.auth.uid
        || (resource.data.playerId == request.auth.uid && resource.data.status == 'PENDING'));
    }

    match /teamJoinCodes/{codeId} {
      allow get: if request.auth != null && (
        get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.createdBy == request.auth.uid
        || (request.auth.token.email_verified == true
          && resource.data.expiresAt > request.time
          && !resource.data.keys().hasAny(['usedBy'])
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['JUGADOR']))
      );
      allow list: if request.auth != null
        && get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.createdBy == request.auth.uid;
      allow create: if isApprovedCoach()
        && request.resource.data.keys().hasOnly(['teamId', 'teamName', 'categories', 'createdBy', 'createdAt', 'expiresAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.teamId is string
        && request.resource.data.teamName == get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.name
        && request.resource.data.categories == get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.categories
        && get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(1, 'h');
      allow update: if false;
      allow delete: if request.auth != null
        && get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.createdBy == request.auth.uid;
    }

    match /teamLineups/{lineupId} {
      allow read: if request.auth != null && (
        get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.createdBy == request.auth.uid
        || exists(/databases/$(database)/documents/teamMemberships/$(resource.data.teamId + '_' + request.auth.uid))
      );
      function validLineup() {
        return request.resource.data.keys().hasOnly(['teamId', 'category', 'formation', 'positions', 'updatedAt'])
          && request.resource.data.teamId is string
          && request.resource.data.category is string
          && lineupId == request.resource.data.teamId + '_' + request.resource.data.category
          && request.resource.data.category in get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.categories
          && request.resource.data.formation in ['4-3-3', '4-4-2', '3-5-2']
          && request.resource.data.positions is map
          && request.resource.data.positions.keys().hasOnly([
            'P0', 'P1', 'P2', 'P3', 'P4', 'P5', 'P6', 'P7', 'P8', 'P9', 'P10'
          ])
          && request.resource.data.updatedAt == request.time;
      }
      allow create, update: if isApprovedCoach()
        && get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.createdBy == request.auth.uid
        && validLineup();
      allow delete: if request.auth != null
        && get(/databases/$(database)/documents/teams/$(resource.data.teamId)).data.createdBy == request.auth.uid;
    }


    // =========================
    // US-22: PRIVACIDAD Y VISIBILIDAD DE DATOS (Fichas de Jugadores)
    // =========================
    // playerProfiles/{id}: datos deportivos. playerPrivate/{id}: físicos, contacto y emergencia.
    // Ambos los leen el jugador, su tutor vinculado, la dueña de un equipo donde es miembro y un admin.

    // La entrenadora guarda en playerCoachLinks/{playerId}_{coachId} el equipo por el que accede;
    // en cada lectura se vuelve a comprobar que el equipo es suyo y que la membresía sigue existiendo.
    function coachOfPlayer(playerId) {
      let linkPath = /databases/$(database)/documents/playerCoachLinks/$(playerId + '_' + request.auth.uid);
      return exists(linkPath)
        && ownsTeam(get(linkPath).data.teamId)
        && exists(/databases/$(database)/documents/teamMemberships/$(get(linkPath).data.teamId + '_' + playerId));
    }

    function canReadPlayer(playerId) {
      return request.auth != null && (
        request.auth.uid == playerId
        || isVerifiedGuardianOf(playerId)
        || isAdmin()
        || coachOfPlayer(playerId)
      );
    }

    match /playerCoachLinks/{linkId} {
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['playerId', 'coachId', 'teamId'])
        && request.resource.data.playerId is string
        && request.resource.data.teamId is string
        && request.resource.data.coachId == request.auth.uid
        && linkId == request.resource.data.playerId + '_' + request.auth.uid
        && ownsTeam(request.resource.data.teamId)
        && exists(/databases/$(database)/documents/teamMemberships/$(request.resource.data.teamId + '_' + request.resource.data.playerId));
      allow read, delete: if false;
    }

    match /playerProfiles/{playerId} {
      allow read: if canReadPlayer(playerId);

      // Campos sensibles que solo existen en perfiles anteriores a la separación (US-22).
      function legacySensitiveKeys() {
        return ['heightCm', 'weightKg', 'phone', 'contactEmail', 'emergencyName', 'emergencyRelation', 'emergencyPhone'];
      }

      function validSportProfile() {
        let d = request.resource.data;
        return (!d.keys().hasAny(['fullName']) || (d.fullName is string && d.fullName.size() <= 80))
          && (!d.keys().hasAny(['position'])
            || d.position in ['', 'Portero', 'Defensa central', 'Lateral', 'Mediocampista', 'Extremo', 'Delantero'])
          && (!d.keys().hasAny(['dominantFoot']) || d.dominantFoot in ['', 'Derecho', 'Izquierdo', 'Ambos'])
          // US-04: miniatura de la foto guardada en el documento (plan Spark, sin Cloud Storage).
          && (!d.keys().hasAny(['photoBase64']) || (d.photoBase64 is string && d.photoBase64.size() <= 800000))
          && (!d.keys().hasAny(['photoPath']) || d.photoPath is string)
          && d.updatedBy == request.auth.uid;
      }

      allow create: if request.auth != null
        && (request.auth.uid == playerId || coachOfPlayer(playerId))
        && request.resource.data.keys().hasOnly([
          'fullName', 'position', 'dominantFoot', 'photoBase64', 'photoPath', 'photoUpdatedAt', 'updatedAt', 'updatedBy'
        ])
        && validSportProfile();

      // El jugador puede dejar los campos sensibles antiguos como estaban o borrarlos
      // (migración a playerPrivate), pero nunca añadirlos ni cambiarlos aquí.
      allow update: if request.auth != null && request.auth.uid == playerId
        && request.resource.data.keys().hasOnly([
          'fullName', 'position', 'dominantFoot', 'photoBase64', 'photoPath', 'photoUpdatedAt', 'updatedAt', 'updatedBy',
          'heightCm', 'weightKg', 'phone', 'contactEmail', 'emergencyName', 'emergencyRelation', 'emergencyPhone'
        ])
        && !request.resource.data.diff(resource.data).addedKeys().hasAny(legacySensitiveKeys())
        && !request.resource.data.diff(resource.data).changedKeys().hasAny(legacySensitiveKeys())
        && validSportProfile();

      // La entrenadora de su equipo solo cambia datos deportivos.
      allow update: if request.auth != null && coachOfPlayer(playerId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName', 'position', 'dominantFoot', 'photoBase64', 'photoPath', 'photoUpdatedAt', 'updatedAt', 'updatedBy'
        ])
        && validSportProfile();

      allow delete: if false;
    }

    match /playerPrivate/{playerId} {
      allow read: if canReadPlayer(playerId);

      function validPrivateProfile() {
        let d = request.resource.data;
        return d.keys().hasOnly([
            'heightCm', 'weightKg', 'phone', 'contactEmail', 'emergencyName', 'emergencyRelation', 'emergencyPhone', 'updatedAt'
          ])
          && (d.get('heightCm', null) == null || (d.heightCm is int && d.heightCm >= 50 && d.heightCm <= 250))
          && (d.get('weightKg', null) == null || (d.weightKg is number && d.weightKg >= 15 && d.weightKg <= 200))
          && d.get('phone', '') is string && d.get('phone', '').size() <= 20
          && d.get('contactEmail', '') is string && d.get('contactEmail', '').size() <= 254
          && d.get('emergencyName', '') is string && d.get('emergencyName', '').size() <= 80
          && d.get('emergencyRelation', '') is string && d.get('emergencyRelation', '').size() <= 40
          && d.get('emergencyPhone', '') is string && d.get('emergencyPhone', '').size() <= 20
          && d.updatedAt == request.time;
      }

      // Solo el propio jugador escribe sus datos sensibles.
      allow create, update: if request.auth != null && request.auth.uid == playerId && validPrivateProfile();
      allow delete: if false;
    }


    // =========================
    // US-04 a US-08: ENTRENAMIENTOS Y JUGADORES
    // =========================

    function ownsTeam(teamId) {
      return get(/databases/$(database)/documents/teams/$(teamId)).data.createdBy == request.auth.uid;
    }

    // Padre o tutor con correo verificado y vinculado por el propio jugador.
    function isVerifiedGuardianOf(playerId) {
      return request.auth != null && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/guardianLinks/$(playerId + '_' + request.auth.uid))
        && get(/databases/$(database)/documents/guardianLinks/$(playerId + '_' + request.auth.uid)).data.status == 'ACTIVE';
    }

    function guardianAccountLabel() {
      let name = request.auth.token.get('name', '');
      return name is string && name.size() > 0 && name.size() <= 80 ? name : request.auth.token.email;
    }

    match /guardianInvites/{inviteId} {
      allow get: if request.auth != null && request.auth.token.email_verified == true
        && (resource.data.playerId == request.auth.uid
          || resource.data.get('guardianId', '') == request.auth.uid
          || (resource.data.status == 'OPEN' && resource.data.expiresAt > request.time
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['PADRE / TUTOR'])));
      allow list: if request.auth != null
        && (resource.data.playerId == request.auth.uid || resource.data.get('guardianId', '') == request.auth.uid);
      allow create: if request.auth != null && request.auth.token.email_verified == true
        && request.resource.data.keys().hasAll(['playerId','playerName','status','createdAt','expiresAt'])
        && request.resource.data.keys().hasOnly(['playerId','playerName','status','createdAt','expiresAt'])
        && request.resource.data.playerId == request.auth.uid
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['JUGADOR'])
        && request.resource.data.playerName is string && request.resource.data.playerName.size() > 0
        && request.resource.data.playerName.size() <= 80 && request.resource.data.status == 'OPEN'
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(1, 'h');
      // El primer tutor que acepta queda ligado a la invitación; el jugador debe confirmar.
      allow update: if request.auth != null && request.auth.token.email_verified == true
        && resource.data.status == 'OPEN' && resource.data.expiresAt > request.time
        && request.auth.uid != resource.data.playerId
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles.hasAny(['PADRE / TUTOR'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','guardianId','guardianName','claimedAt'])
        && request.resource.data.status == 'CLAIMED' && request.resource.data.guardianId == request.auth.uid
        && request.resource.data.guardianName is string && request.resource.data.guardianName.size() > 0
        && request.resource.data.guardianName.size() <= 254
        && request.resource.data.guardianName == guardianAccountLabel()
        && request.resource.data.claimedAt == request.time;
      allow update: if request.auth != null && resource.data.status == 'CLAIMED'
        && resource.data.playerId == request.auth.uid && resource.data.expiresAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','resolvedAt'])
        && request.resource.data.status == 'ACTIVE' && request.resource.data.resolvedAt == request.time
        && getAfter(/databases/$(database)/documents/guardianLinks/$(resource.data.playerId + '_' + resource.data.guardianId)).data.inviteId == inviteId
        && getAfter(/databases/$(database)/documents/guardianLinks/$(resource.data.playerId + '_' + resource.data.guardianId)).data.status == 'ACTIVE';
      allow update: if request.auth != null && resource.data.status in ['OPEN','CLAIMED']
        && (resource.data.playerId == request.auth.uid
          || (resource.data.status == 'CLAIMED' && resource.data.guardianId == request.auth.uid))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','resolvedAt'])
        && request.resource.data.status == 'CANCELLED' && request.resource.data.resolvedAt == request.time;
      allow delete: if false;
    }

    match /guardianLinks/{linkId} {
      allow read: if request.auth != null && (resource.data.playerId == request.auth.uid || resource.data.guardianId == request.auth.uid);
      function validActivation() {
        let d = request.resource.data;
        let invite = get(/databases/$(database)/documents/guardianInvites/$(d.inviteId)).data;
        return request.auth != null && d.keys().hasAll(['playerId','guardianId','inviteId','status','activatedAt'])
          && d.keys().hasOnly(['playerId','guardianId','inviteId','status','activatedAt'])
          && d.playerId == request.auth.uid && d.guardianId is string && d.inviteId is string
          && linkId == d.playerId + '_' + d.guardianId && d.status == 'ACTIVE' && d.activatedAt == request.time
          && invite.status == 'CLAIMED' && invite.expiresAt > request.time
          && invite.playerId == d.playerId && invite.guardianId == d.guardianId
          && getAfter(/databases/$(database)/documents/guardianInvites/$(d.inviteId)).data.status == 'ACTIVE';
      }
      allow create: if validActivation();
      allow update: if resource.data.status == 'REVOKED' && validActivation();
      allow update: if request.auth != null && resource.data.status == 'ACTIVE'
        && (resource.data.playerId == request.auth.uid || resource.data.guardianId == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','revokedAt','revokedBy'])
        && request.resource.data.status == 'REVOKED' && request.resource.data.revokedBy == request.auth.uid
        && request.resource.data.revokedAt == request.time;
      allow delete: if false;
    }

    // US-04: vínculos jugador - padre o tutor. Solo el propio jugador los crea o elimina.
    match /playerGuardians/{linkId} {
      allow read: if request.auth != null && (
        resource.data.playerId == request.auth.uid
        || (request.auth.token.email_verified == true
          && resource.data.guardianEmail == request.auth.token.email.lower())
      );
      allow create: if false;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.playerId == request.auth.uid;
    }

    // US-07: biblioteca de ejercicios compartida. Todos la ven; solo la autora aprobada la modifica.
    match /exercises/{exerciseId} {
      // Nombre visible de la autora: "nombre apellido" de su users/{uid} (o "" si no lo tiene).
      // Se guarda en el ejercicio porque users/{uid} solo lo puede leer su dueño.
      function coachDisplayName() {
        let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
        return (u.get('firstName', '') + ' ' + u.get('lastName', '')).trim();
      }

      function validExercise() {
        let d = request.resource.data;
        return d.name is string
          && d.name.trim().size() > 0
          && d.name.size() <= 80
          // US-07 criterio 1: la descripción es obligatoria.
          && d.description is string
          && d.description.trim().size() > 0
          && d.description.size() <= 500
          && d.durationMinutes is int
          && d.durationMinutes >= 1
          && d.durationMinutes <= 180
          && d.creatorName == coachDisplayName();
      }

      // US-07 criterio 3: los demás roles solo visualizan.
      allow read: if request.auth != null;
      allow create: if isApprovedCoach()
        && request.resource.data.keys().hasOnly(['createdBy', 'creatorName', 'name', 'description', 'durationMinutes', 'createdAt', 'updatedAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && validExercise();
      allow update: if isApprovedCoach()
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description', 'durationMinutes', 'creatorName', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && validExercise();
      // Las sesiones guardan una copia de sus ejercicios, así que eliminar no altera el historial.
      allow delete: if isApprovedCoach() && resource.data.createdBy == request.auth.uid;
    }

    // US-06: sesiones de entrenamiento del equipo.
    match /trainingSessions/{sessionId} {
      function teamDoc(teamId) {
        return get(/databases/$(database)/documents/teams/$(teamId)).data;
      }

      // Copia de un ejercicio de la biblioteca dentro de la sesión. Validación ligera a propósito:
      // Firestore corta en 1000 expresiones por petición y la validación completa (tipos y longitudes
      // de cada campo) solo admitía ~8 ejercicios, e incluso comprobar el tipo de exerciseId y name
      // no cabía con 20. Aquí: exerciseId y name obligatorios y sin campos extra. Tipos, longitudes y
      // duración los garantiza la app. Un valor que no es map da error y se deniega.
      function validSessionExercise(e) {
        let k = e.keys();
        return k.hasAll(['exerciseId', 'name'])
          && k.hasOnly(['exerciseId', 'name', 'description', 'durationMinutes']);
      }
      function exerciseAt(list, i) {
        return list.size() <= i || validSessionExercise(list[i]);
      }
      // Las reglas no tienen bucles: se comprueba cada posición (máximo 20 ejercicios).
      function validExercises(list) {
        return list is list && list.size() <= 20
          && exerciseAt(list, 0)
          && exerciseAt(list, 1)
          && exerciseAt(list, 2)
          && exerciseAt(list, 3)
          && exerciseAt(list, 4)
          && exerciseAt(list, 5)
          && exerciseAt(list, 6)
          && exerciseAt(list, 7)
          && exerciseAt(list, 8)
          && exerciseAt(list, 9)
          && exerciseAt(list, 10)
          && exerciseAt(list, 11)
          && exerciseAt(list, 12)
          && exerciseAt(list, 13)
          && exerciseAt(list, 14)
          && exerciseAt(list, 15)
          && exerciseAt(list, 16)
          && exerciseAt(list, 17)
          && exerciseAt(list, 18)
          && exerciseAt(list, 19);
      }

      function validSession() {
        let d = request.resource.data;
        let team = teamDoc(d.teamId);
        return d.teamId is string
          // US-06: solo se planifica en un EQUIPO (un equipo antiguo sin type cuenta como EQUIPO).
          && team.get('type', 'EQUIPO') == 'EQUIPO'
          && d.teamName == team.name
          && d.category is string
          && (d.category == 'TODAS' || d.category in team.categories)
          && d.date is timestamp
          && d.date > request.time
          && d.durationMinutes is int
          && d.durationMinutes >= 1
          && d.durationMinutes <= 600
          && d.objectives is string
          && d.objectives.trim().size() > 0
          && d.objectives.size() <= 500
          && validExercises(d.exercises);
      }

      // Jugador: sesiones de su equipo para su categoría o para TODAS.
      function playerCanRead(s) {
        let membership = /databases/$(database)/documents/teamMemberships/$(s.teamId + '_' + request.auth.uid);
        return exists(membership)
          && (s.category == 'TODAS' || get(membership).data.get('category', '') == s.category);
      }

      // Tutor: mediante guardianSessionLinks/{teamId}_{categoría}_{tutor}, que se revalida en cada lectura
      // (vínculo ACTIVE con correo verificado y jugador todavía miembro de esa categoría).
      function guardianCanRead(s) {
        let link = /databases/$(database)/documents/guardianSessionLinks/$(s.teamId + '_' + s.category + '_' + request.auth.uid);
        let playerId = get(link).data.playerId;
        let membership = /databases/$(database)/documents/teamMemberships/$(s.teamId + '_' + playerId);
        return exists(link)
          && isVerifiedGuardianOf(playerId)
          && exists(membership)
          && (s.category == 'TODAS' || get(membership).data.get('category', '') == s.category);
      }

      // La entrenadora que la creó, los jugadores y tutores de esa categoría (o TODAS) y el admin (solo lectura).
      allow read: if request.auth != null && (
        resource.data.createdBy == request.auth.uid
        || playerCanRead(resource.data)
        || isAdmin()
        || guardianCanRead(resource.data)
      );
      allow create: if isApprovedCoach()
        && request.resource.data.keys().hasOnly([
          'teamId', 'teamName', 'category', 'createdBy', 'date', 'durationMinutes',
          'objectives', 'exercises', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.createdBy == request.auth.uid
        && ownsTeam(request.resource.data.teamId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && validSession();
      // Solo se modifica o elimina antes de su realización.
      allow update: if isApprovedCoach()
        && resource.data.createdBy == request.auth.uid
        && resource.data.date > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'teamId', 'teamName', 'category', 'date', 'durationMinutes', 'objectives', 'exercises', 'updatedAt'
        ])
        && ownsTeam(request.resource.data.teamId)
        && request.resource.data.updatedAt == request.time
        && validSession();
      allow delete: if isApprovedCoach()
        && resource.data.createdBy == request.auth.uid
        && resource.data.date > request.time;
    }

    // US-06: acceso del tutor a las sesiones de los equipos de su jugador.
    // id "{teamId}_{categoría}_{tutor}"; categoría = la del jugador o 'TODAS'.
    match /guardianSessionLinks/{linkId} {
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['teamId', 'category', 'playerId', 'guardianId'])
        && request.resource.data.teamId is string
        && request.resource.data.category is string
        && request.resource.data.playerId is string
        && request.resource.data.guardianId == request.auth.uid
        && linkId == request.resource.data.teamId + '_' + request.resource.data.category + '_' + request.auth.uid
        && isVerifiedGuardianOf(request.resource.data.playerId)
        && exists(/databases/$(database)/documents/teamMemberships/$(request.resource.data.teamId + '_' + request.resource.data.playerId))
        && (request.resource.data.category == 'TODAS'
          || get(/databases/$(database)/documents/teamMemberships/$(request.resource.data.teamId + '_' + request.resource.data.playerId)).data.get('category', '') == request.resource.data.category);
      allow read, delete: if false;
    }

    // US-08: asistencia; id "{sessionId}_{playerId}" para evitar duplicados.
    match /attendance/{recordId} {
      function attendanceStatuses() {
        return ['PRESENTE', 'TARDANZA', 'AUSENTE', 'JUSTIFICADO'];
      }

      // La entrenadora (o el tutor o el admin) que puede leer el registro con estos datos.
      function canReadAttendance(r) {
        return r.coachId == request.auth.uid
          || r.playerId == request.auth.uid
          || isVerifiedGuardianOf(r.playerId)
          || isAdmin();
      }

      // Datos coherentes con la sesión, el equipo y la membresía (US-08).
      function validAttendance() {
        let d = request.resource.data;
        let session = get(/databases/$(database)/documents/trainingSessions/$(d.sessionId)).data;
        let membershipPath = /databases/$(database)/documents/teamMemberships/$(d.teamId + '_' + d.playerId);
        let membership = get(membershipPath).data;
        return d.coachId == request.auth.uid
          && recordId == d.sessionId + '_' + d.playerId
          && session.createdBy == request.auth.uid
          && session.teamId == d.teamId
          // Solo cuando la sesión ya empezó (las sesiones solo se borran antes de empezar).
          && session.date <= request.time
          && d.sessionDate == session.date
          && d.teamName == get(/databases/$(database)/documents/teams/$(d.teamId)).data.name
          && exists(membershipPath)
          && (session.category == 'TODAS' || membership.get('category', '') == session.category)
          // Si la membresía guarda el nombre, debe coincidir; si no, la app usa un nombre provisional.
          && d.playerName is string && d.playerName.size() > 0 && d.playerName.size() <= 80
          && d.playerName == membership.get('playerName', d.playerName)
          && d.status in attendanceStatuses()
          && d.updatedAt == request.time;
      }

      allow read: if request.auth != null && canReadAttendance(resource.data);

      // Primera marca: createdAt fija la hora del primer registro.
      allow create: if isApprovedCoach()
        && request.resource.data.keys().hasOnly([
          'sessionId', 'teamId', 'teamName', 'coachId', 'playerId', 'playerName', 'status',
          'sessionDate', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.createdAt == request.time
        && validAttendance();

      // Corrección: cambia el estado y deja constancia en changes/{lastChangeId} en el mismo batch.
      // createdAt no cambia nunca (los registros antiguos sin createdAt siguen sin él).
      allow update: if isApprovedCoach()
        && resource.data.coachId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'updatedAt', 'teamName', 'playerName', 'sessionDate', 'lastChangeId'
        ])
        && request.resource.data.status != resource.data.status
        && request.resource.data.lastChangeId is string
        && request.resource.data.lastChangeId != resource.data.get('lastChangeId', '')
        && existsAfter(/databases/$(database)/documents/attendance/$(recordId)/changes/$(request.resource.data.lastChangeId))
        && validAttendance();
      allow delete: if false;

      // Historial de correcciones: solo se crean, junto con la corrección del registro.
      match /changes/{changeId} {
        allow read: if request.auth != null
          && canReadAttendance(get(/databases/$(database)/documents/attendance/$(recordId)).data);
        allow create: if isApprovedCoach()
          && request.resource.data.keys().hasOnly(['from', 'to', 'changedBy', 'changedAt'])
          && request.resource.data.changedBy == request.auth.uid
          && request.resource.data.changedAt == request.time
          && get(/databases/$(database)/documents/attendance/$(recordId)).data.coachId == request.auth.uid
          && get(/databases/$(database)/documents/attendance/$(recordId)).data.get('lastChangeId', '') != changeId
          && getAfter(/databases/$(database)/documents/attendance/$(recordId)).data.lastChangeId == changeId
          && request.resource.data.from == get(/databases/$(database)/documents/attendance/$(recordId)).data.status
          && request.resource.data.to == getAfter(/databases/$(database)/documents/attendance/$(recordId)).data.status
          && request.resource.data.from != request.resource.data.to;
        allow update, delete: if false;
      }
    }

    // US-05: mensualidades simuladas; id "{playerId}_{periodo}" para no duplicar periodos.
    match /monthlyFees/{feeId} {
      // PAGADA lleva fecha de pago (timestamp); PENDIENTE no la tiene.
      function validPaidAt(data) {
        return (data.status == 'PAGADA' && 'paidAt' in data && data.paidAt is timestamp)
          || (data.status == 'PENDIENTE' && !('paidAt' in data));
      }

      // resource == null permite comprobar si el periodo ya existe antes de registrarlo,
      // solo a una entrenadora aprobada (los demás no pueden saber si existe o no).
      // El admin consulta en solo lectura (US-05 criterio 4).
      allow get: if request.auth != null && (
        (resource == null && isApprovedCoach())
        || (resource != null && (
          resource.data.coachId == request.auth.uid
          || resource.data.playerId == request.auth.uid
          || isVerifiedGuardianOf(resource.data.playerId)
          || isAdmin()
        ))
      );
      allow list: if request.auth != null && (
        resource.data.coachId == request.auth.uid
        || resource.data.playerId == request.auth.uid
        || isVerifiedGuardianOf(resource.data.playerId)
        || isAdmin()
      );
      allow create: if isApprovedCoach()
        && request.resource.data.keys().hasOnly([
          'playerId', 'playerName', 'teamId', 'teamName', 'coachId', 'period', 'amount', 'status', 'paidAt', 'updatedAt'
        ])
        && request.resource.data.coachId == request.auth.uid
        && ownsTeam(request.resource.data.teamId)
        && exists(/databases/$(database)/documents/teamMemberships/$(request.resource.data.teamId + '_' + request.resource.data.playerId))
        && request.resource.data.period is string
        && request.resource.data.period.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && feeId == request.resource.data.playerId + '_' + request.resource.data.period
        && request.resource.data.status in ['PENDIENTE', 'PAGADA']
        && (!request.resource.data.keys().hasAny(['amount'])
          || (request.resource.data.amount is number
            && request.resource.data.amount >= 0
            && request.resource.data.amount <= 100000))
        && validPaidAt(request.resource.data)
        && request.resource.data.updatedAt == request.time;
      allow update: if isApprovedCoach()
        && resource.data.coachId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paidAt', 'updatedAt'])
        && request.resource.data.status in ['PENDIENTE', 'PAGADA']
        && validPaidAt(request.resource.data)
        && request.resource.data.updatedAt == request.time;
      // El historial no se borra (US-05 criterio 3).
      allow delete: if false;
    }
  }
}
