rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // USUARIOS
    // =========================
    match /users/{userId} {

      allow read: if request.auth != null
        && request.auth.uid == userId;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'email',
          'roles',
          'profileComplete'
        ])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.profileComplete == true
        && request.resource.data.roles is list
        && request.resource.data.roles.size() > 0
        && request.resource.data.roles.hasOnly([
          'JUGADOR',
          'ENTRENADOR',
          'PADRE / TUTOR'
        ]);

      allow delete: if false;
    }


    // =========================
    // US-18: COMUNIDAD
    // =========================
    match /communityPosts/{postId} {

      // Solo usuarios autenticados pueden ver la comunidad
      allow read: if request.auth != null;

      // Crear publicaciones
      allow create: if request.auth != null

        // El usuario debe tener perfil registrado
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )

        // Solo jugador o entrenador pueden publicar actualmente
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.roles.hasAny([
          'JUGADOR',
          'ENTRENADOR'
        ])

        // Solo permitimos estos campos
        && request.resource.data.keys().hasOnly([
          'authorId',
          'authorName',
          'authorRole',
          'content',
          'visibility',
          'createdAt',
          'active',
          'moderated'
        ])

        // El autor debe ser el usuario autenticado
        && request.resource.data.authorId == request.auth.uid

        && request.resource.data.authorName is string

        // Evita que el usuario se atribuya otro rol
        && request.resource.data.authorRole in [
          'JUGADOR',
          'ENTRENADOR'
        ]

        && request.resource.data.authorRole in get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.roles

        // Validación del contenido
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 1000

        // Opciones válidas de visibilidad
        && request.resource.data.visibility in [
          'TODOS',
          'EQUIPO',
          'ACADEMIA'
        ]

        // Fecha generada por Firebase
        && request.resource.data.createdAt == request.time

        // Una publicación nueva siempre comienza activa
        && request.resource.data.active == true
        && request.resource.data.moderated == false;

      // Todavía no implementamos edición/eliminación
      allow update, delete: if false;
    }
  }
}